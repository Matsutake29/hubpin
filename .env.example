# Supabase（値は .env.local のみ。ここには絶対書かない）
NEXT_PUBLIC_SUPABASE_URL=              # SupabaseプロジェクトのURL（公開可）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # 公開鍵 sb_publishable_...（RLS前提で公開可）
# SUPABASE_SECRET_KEY=                 # ⚠️ 全権キー sb_secret_...・工程13で使用予定。NEXT_PUBLIC_を付けない

# サーバー専用の環境変数（値は .env.local のみ。ここには絶対書かない）
SUPABASE_SECRET_KEY=

# デモアカウント（値は .env.local のみ。ここには絶対書かない）
DEMO_EMAIL=                            # デモログイン用のメールアドレス
DEMO_PASSWORD=                         # 🚨 NEXT_PUBLIC_ を付けない＝サーバー専用